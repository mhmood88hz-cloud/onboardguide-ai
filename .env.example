DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=onboardguide_db

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

JWT_SECRET_KEY=your-long-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

ADMIN_TOKEN=your-admin-token

CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K_CHUNKS=3

# Cloudflare R2 (S3-kompatibel) – persistenter Speicher für Uploads/Bilder,
# da das Dateisystem auf Render bei jedem Redeploy/Restart geleert wird.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=onboardguide-documents

CORS_ORIGINS=
